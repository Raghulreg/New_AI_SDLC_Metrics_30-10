# Copy to .env (never commit .env). Placeholders only — no real values here.
APP_ENV=Development
LOG_LEVEL=INFO

# --- Azure DevOps ---
# Auth: if AZURE_DEVOPS_PAT is set (and APP_ENV is not Production) the backend uses the PAT.
# Otherwise it uses DefaultAzureCredential: `az login` locally, Managed Identity in Azure.
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/YOUR_ORGANIZATION
AZURE_DEVOPS_DEFAULT_PROJECT=YOUR_PROJECT
AZURE_DEVOPS_API_VERSION=7.1
# Local development only. Minimum read-only scopes:
#   Code (Read), Work Items (Read), Build (Read), Project and Team (Read), Test Management (Read)
AZURE_DEVOPS_PAT=
# Optional comma-separated repository GUIDs to restrict PR metrics
ADO_REPOSITORY_IDS=

# --- Cursor (team Admin API key from cursor.com/dashboard -> API Keys; separate from the ADO PAT) ---
# Use ONE of: CURSOR_API_KEY (local) or AZURE_KEY_VAULT_URL + CURSOR_API_KEY_SECRET_NAME (cloud).
# Token usage needs an Admin API key; AI line attribution needs the Enterprise plan (AI Code Tracking API).
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_API_KEY=
AZURE_KEY_VAULT_URL=
CURSOR_API_KEY_SECRET_NAME=
# Optional explicit aliases when an ADO identity's id/uniqueName differs from Cursor email.
# Comma-separated: ADO identity id or uniqueName=Cursor team-member email.
# Exact normalized ADO uniqueName email matches work without this setting.
CURSOR_IDENTITY_MAPPINGS=

# --- Boards / sprint ---
STORY_POINTS_FIELD=Microsoft.VSTS.Scheduling.StoryPoints
SPRINT_WORK_ITEM_TYPES=User Story,Product Backlog Item,Requirement

# --- Defects ---
DEFECT_WORK_ITEM_TYPE=Bug
DEFECT_SEVERITY_FIELD=Microsoft.VSTS.Common.Severity
# Empty = no defect rate (no denominator is assumed). Supported: completed_prs
DEFECT_RATE_DENOMINATOR=

# --- Test coverage ---
# Required for Test Coverage %: pipelines that publish code coverage
COVERAGE_BUILD_DEFINITION_IDS=
COVERAGE_BRANCH=refs/heads/main
COVERAGE_STAT_LABEL=Lines

# --- AI attribution ---
AI_PR_LABELS=ai-assisted
AI_COMMIT_LOOKBACK_DAYS=30

# --- LLM code analysis (optional, off by default) ---
# Estimates AI-generated / AI-assisted / manual for commits Cursor did not track.
# Results are ESTIMATES and are labelled as such; they never override Cursor-verified data.
# Enabling this sends added diff lines (credential-like strings redacted) to the configured endpoint.
LLM_CODE_ANALYSIS_ENABLED=false
# azure_openai (LLM_ENDPOINT = https://YOUR_RESOURCE.openai.azure.com, LLM_MODEL = deployment name),
# openai, or gemini (LLM_ENDPOINT defaults to https://generativelanguage.googleapis.com; LLM_MODEL is a Gemini model id).
LLM_PROVIDER=
LLM_ENDPOINT=
LLM_MODEL=
LLM_API_VERSION=2024-10-21
# Use ONE of: LLM_API_KEY (local) or AZURE_KEY_VAULT_URL + LLM_API_KEY_SECRET_NAME (cloud).
LLM_API_KEY=
LLM_API_KEY_SECRET_NAME=
# Labels below this confidence are counted as unknown.
LLM_MIN_CONFIDENCE=0.7
LLM_MAX_COMMITS=50
LLM_MAX_FILES_PER_COMMIT=20
LLM_MAX_LINES_PER_COMMIT=600
LLM_REQUESTS_PER_MINUTE=30
# Comma-separated glob patterns never sent to the LLM (counted as excluded lines)
LLM_EXCLUDE_PATHS=*.lock,package-lock.json,yarn.lock,pnpm-lock.yaml,poetry.lock,*.min.js,*.min.css,*.map,*.snap

# --- Runtime ---
HTTP_TIMEOUT_SECONDS=30
CACHE_TTL_MINUTES=15
FRESHNESS_WINDOW_MINUTES=60
MAX_PR_DETAIL_FETCH=300
